{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "chaufaltech.com"
        }
      ],
      "destination": "https://www.chaufaltech.com/$1",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/tools",
      "permanent": true
    },
    {
      "source": "/work/:path*",
      "destination": "/tools/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ],
  "functions": {
    "api/audit.js": {
      "maxDuration": 60
    }
  }
}